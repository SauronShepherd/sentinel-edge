{
  "name": "sentinel-client-applications",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "sentinel-client-applications",
      "workspaces": [
        "shared-domain",
        "web",
        "mobile-shell"
      ]
    },
    "mobile-shell": {
      "name": "@sentinel/mobile-shell",
      "version": "0.1.0"
    },
    "node_modules/@sentinel/mobile-shell": {
      "resolved": "mobile-shell",
      "link": true
    },
    "node_modules/@sentinel/shared-domain": {
      "resolved": "shared-domain",
      "link": true
    },
    "node_modules/@sentinel/web": {
      "resolved": "web",
      "link": true
    },
    "shared-domain": {
      "name": "@sentinel/shared-domain",
      "version": "0.1.0"
    },
    "web": {
      "name": "@sentinel/web",
      "version": "0.1.0"
    }
  }
}
