{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sentinel://schemas/correlation-domain-v1",
  "title": "CorrelationDomainV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "id"],
  "properties": {
    "kind": {"type": "string", "enum": ["spatial_cell", "observation_area", "camera_sector", "river_reach", "catchment", "slope", "monitored_site", "unknown"]},
    "id": {"type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[A-Za-z0-9._:-]+$"},
    "domain_policy_id": {"type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[A-Za-z0-9._:-]+$"}
  }
}
