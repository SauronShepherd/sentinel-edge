{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinel-edge.local/schemas/test-evidence.schema.json",
  "title": "Sentinel Edge immutable test evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "recorded_at",
    "command",
    "revision",
    "environment",
    "inputs",
    "result",
    "duration_seconds",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "evidence_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "object",
      "required": [
        "name",
        "python",
        "platform"
      ],
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string"
        },
        "python": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "result": {
      "enum": [
        "passed",
        "failed",
        "blocked"
      ]
    },
    "duration_seconds": {
      "type": "number",
      "minimum": 0
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "xfailed": {
          "type": "integer",
          "minimum": 0
        },
        "rerun": {
          "type": "integer",
          "minimum": 0
        },
        "collection_errors": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
