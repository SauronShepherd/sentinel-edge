{
  "authorities": {
    "client_mutation_boundary": "rest-api-integration-gateway",
    "collector": "streaming-source-collector",
    "incident_lifecycle": "incident-event-engine",
    "workload_execution": "model-workload-runtime"
  },
  "namespaces": [
    {
      "owner": "streaming-source-collector",
      "path": "runtime/collector"
    },
    {
      "owner": "analysis-enrichment-engine",
      "path": "runtime/analyzer"
    },
    {
      "owner": "model-workload-runtime",
      "path": "runtime/runtime"
    },
    {
      "owner": "incident-event-engine",
      "path": "runtime/incidents"
    },
    {
      "owner": "rest-api-integration-gateway",
      "path": "runtime/api"
    },
    {
      "owner": "client-applications",
      "path": "runtime/client"
    }
  ],
  "resources": {
