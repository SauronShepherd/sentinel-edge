      "analyzer": "runtime/analyzer/artifacts",
      "api": "runtime/api/artifacts",
      "collector": "runtime/collector/artifacts",
      "incidents": "runtime/incidents/artifacts",
      "runtime": "runtime/runtime/artifacts"
    },
    "databases": {
      "analyzer": "runtime/analyzer/analyzer.db",
      "api": "runtime/api/api.db",
      "collector": "runtime/collector/collector.db",
      "incidents": "runtime/incidents/incidents.db",
      "runtime": "runtime/runtime/runtime.db"
    },
    "secrets": {
      "analyzer": "runtime/analyzer/secrets",
      "api": "runtime/api/secrets",
      "collector": "runtime/collector/secrets",
      "incidents": "runtime/incidents/secrets",
      "runtime": "runtime/runtime/secrets"
    }
  },
  "undeclared_resources": []
}
